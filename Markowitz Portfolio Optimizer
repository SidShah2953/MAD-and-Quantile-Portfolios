import pandas as pd
import numpy as np
from scipy.optimize import minimize
from empyrical import max_drawdown

class MarkowitzPortfolioOptimizer:
    def __init__(self, etfs, risk_tolerance, input_path):
        """
        Initialize optimizer with ETF return files.
        :param etfs: List of ETF symbols
        :param risk_tolerance: Maximum acceptable volatility (e.g., 0.15 for 15%)
        :param input_path: Path to ETF returns data directory
        """
        self.etfs = etfs
        self.risk_tolerance = risk_tolerance
        self.input_path = input_path
        self.returns_df = self._load_returns()
        self.weights = None

    def _load_returns(self):
        """
        Load ETF return data from CSV files.
        :return: DataFrame of ETF returns
        """
        data = {}
        for etf in self.etfs:
            df = pd.read_csv(f'{self.input_path}/{etf}_weekly_return_detailed.csv', parse_dates=['Date'])
            df.set_index('Date', inplace=True)
            df.rename(columns={'Return': etf}, inplace=True)
            data[etf] = df[etf] / 100  # Convert percentage returns to decimal
        return pd.DataFrame(data).dropna()

    def _portfolio_statistics(self, weights):
        """
        Compute portfolio return and volatility.
        :param weights: Portfolio weights
        :return: Tuple (expected return, annualized volatility)
        """
        mean_returns = self.returns_df.mean()
        cov_matrix = self.returns_df.cov()
        portfolio_return = np.dot(weights, mean_returns)
        portfolio_volatility = np.sqrt(np.dot(weights.T, np.dot(cov_matrix, weights))) * np.sqrt(252)  # Annualized volatility
        return portfolio_return, portfolio_volatility

    def _objective_function(self, weights):
        """
        Objective function for optimization: maximize return with a risk constraint.
        :param weights: Portfolio weights
        :return: Negative portfolio return (since we maximize return)
        """
        portfolio_return, portfolio_volatility = self._portfolio_statistics(weights)
        return -portfolio_return  # Negative because we use `minimize()`

    def optimize_portfolio(self):
        """
        Compute optimal ETF weights using Markowitz optimization with a risk constraint.
        :return: DataFrame of optimal portfolio weights
        """
        num_assets = len(self.etfs)
        initial_weights = np.ones(num_assets) / num_assets  # Equal weight start
        bounds = tuple((0, 1) for _ in range(num_assets))  # No shorting, no leverage
        constraints = [
            {'type': 'eq', 'fun': lambda x: np.sum(x) - 1},  # Sum of weights = 1
            {'type': 'ineq', 'fun': lambda x: self.risk_tolerance - self._portfolio_statistics(x)[1]}  # Risk constraint
        ]

        result = minimize(
            self._objective_function,
            initial_weights,
            method='SLSQP',
            bounds=bounds,
            constraints=constraints
        )

        if not result.success:
            raise ValueError("Optimization failed!")

        self.weights = pd.DataFrame({'ETF': self.etfs, 'Weight': result.x})
        return self.weights

    def compute_annual_statistics(self, initial_cash=100):
        """
        Compute annual return statistics for the optimized portfolio.
        :param initial_cash: Starting portfolio value (default: $100)
        :return: DataFrame with annual statistics
        """
        if self.weights is None:
            raise ValueError("Run optimize_portfolio() before computing statistics.")

        # Compute weighted portfolio returns
        strategy_returns = self.returns_df.dot(self.weights['Weight'].values)

        annual_stats = []
        cash = initial_cash

        for year in range(2000, 2025):
            if year not in strategy_returns.index.year:
                continue
            annual_return = (1 + strategy_returns.loc[str(year)]).prod() - 1  # Compounded annual return
            cash *= (1 + annual_return)
            annual_volatility = strategy_returns.loc[str(year)].std() * np.sqrt(252)
            sharpe_ratio = annual_return / annual_volatility if annual_volatility > 0 else np.nan
            mdd = max_drawdown(strategy_returns.loc[str(year)])
            annual_stats.append([year, cash, annual_return, annual_volatility, sharpe_ratio, mdd])

        return pd.DataFrame(annual_stats, columns=['Year', 'Cash Value', 'Annual Return', 'Volatility', 'Sharpe Ratio', 'Max Drawdown'])

    def run(self):
        """
        Run the entire optimization process and display results.
        """
        print("Optimizing Portfolio...")
        optimal_weights = self.optimize_portfolio()
        print("\nOptimal Portfolio Weights:\n", optimal_weights)

        print("\nComputing Annual Statistics...")
        annual_stats = self.compute_annual_statistics()
        print("\nAnnual Portfolio Performance:\n", annual_stats)

        # Save results
        optimal_weights.to_csv("markowitz_optimal_weights.csv", index=False)
        annual_stats.to_csv("markowitz_annual_cash.csv", index=False)
        print("\nResults saved to CSV.")

